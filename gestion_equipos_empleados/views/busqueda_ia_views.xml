<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_busqueda_ia_form" model="ir.ui.view">
        <field name="name">AI Search</field>
        <field name="model">gestion.busqueda.ia</field>
        <field name="arch" type="xml">
            <form string="Search with AI">
                <sheet>
                    <group>
                        <field name="pregunta" string="Question"/>
                        <field name="respuesta" string="Answer" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Search" type="object" name="buscar_con_ia" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_busqueda_ia" model="ir.actions.act_window">
        <field name="name">Search with AI</field>
        <field name="res_model">gestion.busqueda.ia</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
