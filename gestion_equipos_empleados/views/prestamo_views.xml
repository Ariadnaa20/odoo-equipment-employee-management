<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Llista -->
    <record id="view_prestamo_list" model="ir.ui.view">
        <field name="name">prestamo.list</field>
        <field name="model">gestion.prestamo</field>
        <field name="arch" type="xml">
            <list string="Loans">
                <field name="display_name"/>
                <field name="fecha_inicio" string="Start Date"/>
                <field name="fecha_fin" string="End Date"/>
                <field name="estado" string="Status"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulari -->
    <record id="view_prestamo_form" model="ir.ui.view">
        <field name="name">prestamo.form</field>
        <field name="model">gestion.prestamo</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <sheet>
                    <header>
                        <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                        <button name="action_send_report_email" string="Send by Email" type="object" class="btn-secondary"/>
                    </header>
                    <group>
                        <group>
                            <field name="equipo_id" string="Equipment"/>
                            <field name="empleado_id" string="Employee"/>
                            <field name="signature" widget="signature" string="Signature"/>
                        </group>
                        <group>
                            <field name="fecha_inicio" string="Start Date"/>
                            <field name="fecha_fin" string="End Date"/>
                            <field name="estado" string="Status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observations">
                            <field name="observacions"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acció: Préstecs -->
    <record id="action_gestion_prestamo" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">gestion.prestamo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
