<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_equipo_list" model="ir.ui.view">
        <field name="name">equipo.list</field>
        <field name="model">gestion.equipo</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="display_name" string="Name"/>
                <field name="tipo" string="Type"/>
                <field name="estado" string="Status"/>
                <field name="numero_serie" string="Serial Number"/>
                <field name="fecha_alta" string="Date Added"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_equipo_form" model="ir.ui.view">
        <field name="name">equipo.form</field>
        <field name="model">gestion.equipo</field>
        <field name="arch" type="xml">
            <form string="Computer Equipment">
                <sheet>

                    <!-- Action Button -->
                    <header>
                        <button name="action_print_etiqueta_qr"
                                string="Print Label"
                                type="object"
                                class="btn-primary"/>
                    </header>

                    <!-- Image -->
                    <field name="imagen" widget="image" class="oe_avatar" string="Image"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Equipment Name"/>
                        </h1>
                    </div>

                    <!-- Data -->
                    <group>
                        <group>
                            <field name="marca" string="Brand"/>
                            <field name="modelo" string="Model"/>
                            <field name="numero_serie" string="Serial Number"/>
                            <field name="tipo" string="Type"/>
                            <!-- QR -->
                            <field name="qr_image" widget="image" class="oe_avatar" options="{'preview_image': 'qr_image'}" string="QR Code"/>
                        </group>
                        <group>
                            <field name="estado" string="Status"/>
                            <field name="fecha_alta" string="Date Added"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="descripcion"/>
                        </page>
                        <page string="Loans">
                            <field name="prestamo_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_equipo_search" model="ir.ui.view">
        <field name="name">equipo.search</field>
        <field name="model">gestion.equipo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="marca" string="Brand"/>
                <field name="modelo" string="Model"/>
                <field name="numero_serie" string="Serial Number"/>
                <filter string="Available" name="disponible" domain="[('estado', '=', 'disponible')]"/>
                <filter string="On Loan" name="prestado" domain="[('estado', '=', 'prestado')]"/>
                <group expand="0" string="Group by">
                    <filter string="Type" name="tipo" context="{'group_by': 'tipo'}"/>
                    <filter string="Status" name="estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Action -->
    <record id="action_gestion_equipo" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">gestion.equipo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipo_search"/>
    </record>
</odoo>
